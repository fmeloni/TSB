; DO-TEST.DMO from corpus/tsbneo_260228.d64, corrected for TSB Neo (decision 11 Nov, plan task 1.5).
; The original stops with ?BAD MODE ERROR IN 130: FETCH needs a string variable. The only change: the four
; FETCH ...,1,E lines read into E$ and then set E=VAL(E$). Every other byte is the original's
; (tests/corpus_fixed.py checks this). The original disk stays untouched.
90 REM"{$C4}{$CF}-{$D4}EST VON {$CF}MEGA
100 LOOP
110 MENUA
120 PRINT"{$C9}HRE {$C5}INGABE: ";
130 FETCH "1234567",1,E$:E=VAL(E$)
140 IF E>=1 AND E<=3 THEN DO
150 COLOR E-1,12
160 ELSE
170 IF E=4 THEN DO
175 REPEAT
180 MENUB
190 PRINT"{$C9}HRE {$C5}INGABE: ";
200 FETCH "1234",1,E$:E=VAL(E$)
210 IF E>=1 AND E<=3 THEN DO
220 COLOR E-1+3,12
230 DONE
235 UNTIL E=4
240 DONE
250 IF E=5 THEN DO
255 REPEAT
260 MENUC
270 PRINT"{$C9}HRE {$C5}INGABE: ";
280 FETCH "1234",1,E$:E=VAL(E$)
290 IF E>=1 AND E<=3 THEN DO
300 COLOR E-1+6,12
310 DONE
315 UNTIL E=4
320 DONE
330 IF E=6 THEN DO
335 REPEAT
340 MENUD
350 PRINT"{$C9}HRE {$C5}INGABE: ";
360 FETCH "1234",1,E$:E=VAL(E$)
370 IF E>=1 AND E<=3 THEN DO
380 COLOR E-1+9,12
390 DONE
395 UNTIL E=4
400 DONE
410 IF E=7 THEN DO
420 END
430 DONE
440 DONE
450 END LOOP
460 END
